# ============================================================================
# PARAMS for github/sync-secrets-manager-to-github-secrets — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in the
# repo-root .env; setting one of those keys here is a hard error.
#
# This integration declares credentials: ["aws", "github"].
# ============================================================================

# ARN or friendly name — Secrets Manager's SecretId accepts either.
SOURCE_SECRET_ID=

OWNER=
REPO=
# "repo" or "environment".
TARGET_SCOPE=repo
# Required when TARGET_SCOPE=environment.
ENVIRONMENT_NAME=

# May differ from the Secrets Manager secret's own name.
TARGET_SECRET_NAME=
