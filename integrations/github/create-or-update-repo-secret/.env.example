# ============================================================================
# PARAMS for github/create-or-update-repo-secret — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in the
# repo-root .env; setting one of those keys here is a hard error.
#
# This integration declares credentials: ["github"] only.
# ============================================================================

OWNER=
REPO=
SECRET_NAME=
# Never logged, never written to the report — only held in process memory
# for the duration of this run.
SECRET_VALUE=

# Set true to force a re-encrypt + re-write on every run, bypassing the
# presence check. Defaults false to avoid needless API calls / updated_at
# churn on an otherwise-stable secret.
FORCE_ROTATE=false
