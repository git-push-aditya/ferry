# ============================================================================
# PARAMS for github/github-oidc-spoke-role — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in the
# repo-root .env; setting one of those keys here is a hard error.
#
# Run this once PER TARGET AWS ACCOUNT, using that account's own root .env
# credentials. This integration never holds multiple AWS credential sets in
# one run — see README for why.
# ============================================================================

# The hub account's OIDC-trusted role ARN — from a single
# github/setup-github-actions-oidc-role run against the hub account.
HUB_ROLE_ARN=

SPOKE_ROLE_NAME=
# Comma-separated managed policy ARNs to attach in THIS account.
SPOKE_PERMISSION_POLICY_ARNS=
ROLE_DESCRIPTION=
