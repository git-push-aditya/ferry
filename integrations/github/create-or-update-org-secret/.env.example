# ============================================================================
# PARAMS for github/create-or-update-org-secret — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in the
# repo-root .env; setting one of those keys here is a hard error.
#
# This integration declares credentials: ["github"] only.
# ============================================================================

ORG=
SECRET_NAME=
SECRET_VALUE=

# "all", "private", or "selected".
VISIBILITY=private

# JSON array of repo database ids (not names). Only used when VISIBILITY=selected.
SELECTED_REPOSITORY_IDS=[]

FORCE_ROTATE=false
