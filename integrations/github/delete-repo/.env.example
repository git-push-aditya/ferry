# ============================================================================
# PARAMS for github/delete-repo — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in the
# repo-root .env; setting one of those keys here is a hard error.
#
# This integration declares credentials: ["github"] only.
# ============================================================================

OWNER=
REPO=

# Hard confirmation gate — see README.md. Defaults false; the plan phase
# aborts with a "conflict" until this is explicitly set true.
ALLOW_DESTRUCTIVE_TEARDOWN=false
