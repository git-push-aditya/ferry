# ============================================================================
# PARAMS for github/create-deploy-key — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in the
# repo-root .env; setting one of those keys here is a hard error.
#
# This integration declares credentials: ["github"] only.
# ============================================================================

OWNER=
REPO=
TITLE=
# Public key material only, e.g. "ssh-ed25519 AAAA... deploy@example".
# Private key generation is outside this integration's scope.
PUBLIC_KEY=

# false grants write access — a meaningfully higher-privilege setting.
# Defaults true.
READ_ONLY=true
