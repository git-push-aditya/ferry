# ============================================================================
# PARAMS for github/create-webhook — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in the
# repo-root .env; setting one of those keys here is a hard error.
#
# This integration declares credentials: ["github"] only.
# ============================================================================

OWNER=
REPO=
URL=
CONTENT_TYPE=json
# Never logged. Used as the HMAC signing secret on the receiving end.
SECRET=
# JSON array of event names, e.g. ["push","pull_request"]
EVENTS=["push"]
ACTIVE=true
