# ============================================================================
# PARAMS for github/terraform-state-backend-for-actions — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in the
# repo-root .env; setting one of those keys here is a hard error.
#
# This integration declares credentials: ["aws"] only. It never mints the
# CI/OIDC role — run github/setup-github-actions-oidc-role first and pass
# its AWS_ROLE_NAME here.
# ============================================================================

AWS_ROLE_NAME=
S3_BUCKET_NAME=
STATE_KEY_PREFIX=terraform-state
