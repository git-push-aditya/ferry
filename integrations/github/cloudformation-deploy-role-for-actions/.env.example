# ============================================================================
# PARAMS for github/cloudformation-deploy-role-for-actions — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in the
# repo-root .env; setting one of those keys here is a hard error.
#
# This integration declares credentials: ["aws"] only. It never mints the
# CI/OIDC role — run github/setup-github-actions-oidc-role first and pass
# its AWS_ROLE_NAME here.
# ============================================================================

AWS_ROLE_NAME=
CFN_EXECUTION_ROLE_NAME=

# What CloudFormation is actually allowed to create/modify mid-deploy.
# Comma-separated managed policy ARNs — this integration does not invent a
# minimal policy for arbitrary stacks, since there is no universal minimal
# set; supply whatever fits what your stacks manage.
EXECUTION_POLICY_ARNS=

# Scopes the CI role's cloudformation:* grant to stacks whose name starts
# with this prefix, e.g. "myapp-" allows stack/myapp-*/*.
STACK_NAME_PREFIX=

# Deliberately gated: deleting the execution role on rollback could strand
# a real in-flight or completed deploy that referenced it. Defaults false.
ALLOW_DESTRUCTIVE_ROLLBACK=false
