# ============================================================================
# PARAMS for github/trigger-workflow-dispatch — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in the
# repo-root .env; setting one of those keys here is a hard error.
#
# This integration declares credentials: ["github"] only.
# ============================================================================

OWNER=
REPO=
# A numeric workflow id, or the workflow file's basename, e.g. "ci.yml".
WORKFLOW_ID=
REF=main

# Flat JSON object of string -> string, must match the workflow's own
# declared workflow_dispatch.inputs schema.
INPUTS_JSON={}

WAIT_FOR_COMPLETION=false
POLL_TIMEOUT_MS=600000
EXPECTED_CONCLUSION=success
