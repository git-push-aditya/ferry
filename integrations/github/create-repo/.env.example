# ============================================================================
# PARAMS for github/create-repo — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in the
# repo-root .env; setting one of those keys here is a hard error.
#
# This integration declares credentials: ["github"] only.
# ============================================================================

# --- Repo identity ---
OWNER=
REPO=
# "org" posts to /orgs/{OWNER}/repos, "user" posts to /user/repos.
OWNER_TYPE=user

# --- Optional ---
DESCRIPTION=
# "public" or "private". Left unset uses GitHub's own account default.
VISIBILITY=

# Defaults to true — creates an initial commit with a README. Downstream
# tasks like update-branch-protection need at least one branch to exist.
AUTO_INIT=true
GITIGNORE_TEMPLATE=
LICENSE_TEMPLATE=

# Hard confirmation gate for rollback — see README.md. Defaults false.
ALLOW_DESTRUCTIVE_ROLLBACK=false
