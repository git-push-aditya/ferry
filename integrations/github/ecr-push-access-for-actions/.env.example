# ============================================================================
# PARAMS for github/ecr-push-access-for-actions — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in the
# repo-root .env; setting one of those keys here is a hard error.
#
# This integration declares credentials: ["aws"] only. It never mints the
# OIDC role — run github/setup-github-actions-oidc-role first and pass its
# AWS_ROLE_NAME here.
# ============================================================================

AWS_ROLE_NAME=
ECR_REPOSITORY_NAME=

# "MUTABLE" or "IMMUTABLE". IMMUTABLE by default — a tag can't be silently
# overwritten once pushed.
IMAGE_TAG_MUTABILITY=IMMUTABLE

# Deliberately gated: deleting an ECR repository on rollback destroys any
# images pushed to it since creation. Defaults false.
ALLOW_DESTRUCTIVE_ROLLBACK=false
