# ============================================================================
# PARAMS for github/create-environment — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in the
# repo-root .env; setting one of those keys here is a hard error.
#
# This integration declares credentials: ["github"] only.
# ============================================================================

OWNER=
REPO=
ENVIRONMENT_NAME=production

WAIT_TIMER=0
# JSON array of {"type":"User"|"Team","id":number}
REVIEWERS=[]

ENABLE_DEPLOYMENT_BRANCH_POLICY=false
PROTECTED_BRANCHES=false
CUSTOM_BRANCH_POLICIES=false
