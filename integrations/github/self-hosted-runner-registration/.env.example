# ============================================================================
# PARAMS for github/self-hosted-runner-registration — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in the
# repo-root .env; setting one of those keys here is a hard error.
#
# This integration declares credentials: ["aws", "github"].
# ============================================================================

# --- where the runner registers ---------------------------------------------
# "repo" or "org".
SCOPE=repo
OWNER=
REPO=
# Only for SCOPE=org.
ORG=

RUNNER_NAME=
RUNNER_LABELS=["self-hosted","linux","x64"]
# 1 is "Default" on every account.
RUNNER_GROUP_ID=1

# --- the instance it runs on ------------------------------------------------
# STRONGLY recommended: an AMI with the runner binary already installed at
# RUNNER_DIR. A JIT config expires faster than an install-on-boot script
# usually finishes — see the README.
AMI_ID=
INSTANCE_TYPE=t3.medium
SUBNET_ID=
# Comma-separated.
SECURITY_GROUP_IDS=
KEY_PAIR_NAME=

RUNNER_DIR=/opt/actions-runner
RUNNER_USER=ec2-user

# --- the IAM identity the instance assumes ----------------------------------
# Created by this integration, with an EC2 trust policy and NO permissions.
IAM_ROLE_NAME=
IAM_INSTANCE_PROFILE_NAME=
