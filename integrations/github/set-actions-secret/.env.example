# ============================================================================
# PARAMS for github/set-actions-secret — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in the
# repo-root .env; setting one of those keys here is a hard error.
#
# This integration declares credentials: ["github"] only.
# ============================================================================

# "repo", "org", or "environment". Decides which of the blocks below apply.
SCOPE=repo

SECRET_NAME=
SECRET_VALUE=

# Overwrite even when a secret of this name already exists. Default false,
# because the value is unreadable so a blind rewrite churns updated_at for
# no observable change. See README.
FORCE_ROTATE=false

# --- SCOPE=repo and SCOPE=environment ---------------------------------------
OWNER=
REPO=

# --- SCOPE=environment ------------------------------------------------------
ENVIRONMENT_NAME=

# --- SCOPE=org --------------------------------------------------------------
ORG=

# "all", "private", or "selected".
VISIBILITY=private

# JSON array of repo database ids (not names). Only used when VISIBILITY=selected.
SELECTED_REPOSITORY_IDS=[]
