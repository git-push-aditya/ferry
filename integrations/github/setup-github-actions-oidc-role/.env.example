# ============================================================================
# PARAMS for github/setup-github-actions-oidc-role — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in the
# repo-root .env; setting one of those keys here is a hard error.
#
# This integration declares credentials: ["aws"] only — it never calls a
# GitHub API, so no GITHUB_TOKEN is needed to run it.
# ============================================================================

GITHUB_OWNER=
GITHUB_REPO=
# "branch" or "environment".
SCOPE_TYPE=branch
# A branch name (when SCOPE_TYPE=branch) or an environment name (when
# SCOPE_TYPE=environment).
SCOPE_VALUE=main

# Deliberate opt-in loosening — widens trust to any ref/environment in this
# repo. Defaults false.
ALLOW_ANY_REF_OR_ENVIRONMENT=false

AWS_ROLE_NAME=
ROLE_DESCRIPTION=
# JSON array of policy ARNs to attach, e.g. ["arn:aws:iam::aws:policy/ReadOnlyAccess"]
PERMISSION_POLICY_ARNS=[]
