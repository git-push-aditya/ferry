# ============================================================================
# PARAMS for aws/s3-backend-access — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in the
# repo-root .env; setting one of those keys here is a hard error.
#
# This integration declares credentials: ["aws"] only — it never touches
# Snowflake and never asks for Snowflake credentials.
# ============================================================================

# --- S3 target ---
# The bucket the backend service needs to read/write. It may well already exist
# (created by the storage integration, Terraform, or a platform team): ferry
# reuses it and will not delete a bucket it did not create.
EXPORT_S3_BUCKET=
# Key prefix used for the live write/read/delete verification. MUST end with '/'.
EXPORT_S3_PREFIX=

# --- AWS IAM object names ---
BACKEND_IAM_USER_NAME=
BACKEND_IAM_POLICY_NAME=
