# ============================================================================
# PARAMS for aws/s3/update-bucket-region — NO CREDENTIALS.
#
# S3 has no in-place region migration. The new bucket is created in whatever
# region your root .env's AWS_REGION credential specifies for this run — set
# that to the target region before running.
# ============================================================================

OLD_S3_BUCKET_NAME=
NEW_S3_BUCKET_NAME=
