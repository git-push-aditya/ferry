# ============================================================================
# PARAMS for aws/s3/create-bucket — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in the
# repo-root .env; setting one of those keys here is a hard error.
#
# This integration declares credentials: ["aws"] only.
# ============================================================================

# --- Bucket ---
# Bare bucket name — no s3:// prefix, no trailing slash. Bucket names are
# globally unique across every AWS account; a name taken elsewhere aborts the
# run in the plan phase, before anything is created.
S3_BUCKET_NAME=

# --- Optional bucket-level settings — each opted into independently ---
# "true" or "false" only. Leaving all three at their defaults below provisions
# a plain bucket with just AWS's own baseline (SSE-S3, no explicit versioning).

# Once enabled, versioning cannot be returned to "never configured" — only to
# Suspended. Defaults to false.
ENABLE_VERSIONING=false

# Sets an explicit default-encryption configuration. Defaults to false, which
# leaves AWS's own default SSE-S3 baseline in place (every bucket gets this
# regardless — "false" here just means ferry won't set anything explicit).
ENABLE_ENCRYPTION=false
# AES256 or aws:kms. Ignored if ENABLE_ENCRYPTION=false.
ENCRYPTION_ALGORITHM=AES256
# Required only if ENCRYPTION_ALGORITHM=aws:kms.
ENCRYPTION_KMS_KEY_ID=

# Defaults to true (the safe choice) — a freshly provisioned bucket should not
# be publicly reachable by accident. Set to false only if you genuinely want a
# public bucket.
BLOCK_PUBLIC_ACCESS=true
