# ============================================================================
# PARAMS for aws/s3/enable-bucket-logging — NO CREDENTIALS.
#
# This integration operates on two buckets that already exist — it creates
# neither. Run aws/s3/create-bucket first for any that don't exist yet.
# ============================================================================

S3_BUCKET_NAME=
LOGGING_TARGET_BUCKET=
# Must end with '/'.
LOGGING_TARGET_PREFIX=
