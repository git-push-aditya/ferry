# ============================================================================
# PARAMS for aws/s3/enable-bucket-lifecycle-rules — NO CREDENTIALS.
#
# This integration operates on a bucket that already exists — it does not
# create one. Run aws/s3/create-bucket first if you need it provisioned.
# ============================================================================

S3_BUCKET_NAME=
# A JSON array of AWS's own LifecycleRule objects, e.g.:
#   [{"ID":"expire-logs","Filter":{"Prefix":"logs/"},"Status":"Enabled","Expiration":{"Days":365}}]
# Leave empty to leave whatever lifecycle configuration the bucket already has
# untouched. Set to [] explicitly to clear every rule. PutBucketLifecycle
# replaces the whole document — include every rule you want kept.
LIFECYCLE_RULES_JSON=
