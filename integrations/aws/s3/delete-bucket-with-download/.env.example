# ============================================================================
# PARAMS for aws/s3/delete-bucket-with-download — NO CREDENTIALS.
# ============================================================================

SOURCE_S3_BUCKET_NAME=
# Local directory to download into. Created if it doesn't exist.
DOWNLOAD_DIR=./ferry-download
# true recreates each key's "/" as real subdirectories; false flattens every
# key into one filename.
PRESERVE_KEY_PREFIX_STRUCTURE=true
