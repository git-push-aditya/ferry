# ============================================================================
# PARAMS for aws/s3/update-bucket-encryption — NO CREDENTIALS.
#
# This integration operates on a bucket that already exists — it does not
# create one. Run aws/s3/create-bucket first if you need it provisioned.
# ============================================================================

S3_BUCKET_NAME=
# AES256 or aws:kms.
ENCRYPTION_ALGORITHM=AES256
# Required only if ENCRYPTION_ALGORITHM=aws:kms.
ENCRYPTION_KMS_KEY_ID=
