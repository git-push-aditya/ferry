# ============================================================================
# PARAMS for aws/s3/update-bucket-versioning — NO CREDENTIALS.
#
# This integration operates on a bucket that already exists — it does not
# create one. Run aws/s3/create-bucket first if you need it provisioned.
# ============================================================================

S3_BUCKET_NAME=
# Enabled or Suspended. Once versioning has ever been touched, S3 has no way
# back to "never configured" — only these two states.
DESIRED_VERSIONING_STATUS=Enabled
