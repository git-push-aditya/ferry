# ============================================================================
# PARAMS for aws/s3/decommission-bucket — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in the
# repo-root .env; setting one of those keys here is a hard error.
#
# This integration declares credentials: ["aws"] only.
# ============================================================================

SOURCE_S3_BUCKET_NAME=

# "none", "download", or "transfer".
#   none      refuse unless the bucket is already empty
#   download  write every object to DOWNLOAD_DIR first
#   transfer  copy every object into DESTINATION_S3_BUCKET_NAME first
DRAIN_MODE=transfer

# --- DRAIN_MODE=transfer ----------------------------------------------------
DESTINATION_S3_BUCKET_NAME=

# --- DRAIN_MODE=download ----------------------------------------------------
DOWNLOAD_DIR=
PRESERVE_KEY_PREFIX_STRUCTURE=true
