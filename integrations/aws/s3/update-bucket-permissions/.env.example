# ============================================================================
# PARAMS for aws/s3/update-bucket-permissions — NO CREDENTIALS.
#
# This integration operates on a bucket that already exists — it does not
# create one. Run aws/s3/create-bucket first if you need it provisioned.
#
# ACLs are out of scope on purpose — see params.ts.
# ============================================================================

S3_BUCKET_NAME=
# A full bucket policy document, as one line of JSON. Leave empty to leave
# whatever policy the bucket already has untouched.
BUCKET_POLICY_JSON=
# Defaults to true (the safe choice).
BLOCK_PUBLIC_ACCESS=true
