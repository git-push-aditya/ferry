# ============================================================================
# PARAMS for aws/s3/tag-bucket — NO CREDENTIALS.
#
# This integration operates on a bucket that already exists — it does not
# create one. Run aws/s3/create-bucket first if you need it provisioned.
# ============================================================================

S3_BUCKET_NAME=
# A flat JSON object of string tags, e.g. {"env":"prod","owner":"data-team"}.
# Leave empty to leave whatever tags the bucket already has untouched. Set to
# {} explicitly to clear every tag. PutBucketTagging replaces the whole set —
# include every tag you want kept, not just the ones you're changing.
TAGS_JSON=
