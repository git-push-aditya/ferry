# ============================================================================
# PARAMS for aws/ec2/terminate-instance — NO CREDENTIALS.
# ============================================================================

INSTANCE_ID=

# Optional — "true" or "false", default "false". When true, check() aborts
# with a conflict (instead of proceeding) if the instance has an attached EBS
# volume with DeleteOnTermination=false — a straight terminate would detach
# and preserve that volume, but with no record of the connection, so this
# stops the run before it promises something that could strand a volume.
PRESERVE_VOLUME_CHECK=false
