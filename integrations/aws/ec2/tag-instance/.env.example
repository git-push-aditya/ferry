# ============================================================================
# PARAMS for aws/ec2/tag-instance — NO CREDENTIALS.
#
# This integration operates on an instance that already exists — it does not
# create one. Run aws/ec2/launch-instance first if you need it provisioned.
# ============================================================================

INSTANCE_ID=

# A flat JSON object of string tags, e.g. {"env":"prod","owner":"data-team"}.
# Required. Keys here are added/updated (CreateTags overwrites a key that
# already exists) — tags not listed here are left untouched unless
# PRUNE_UNMANAGED_TAGS=true.
TAGS=

# Optional — default false. When true, tags currently on the instance but
# absent from TAGS above are deleted. Default false: this step only ever
# adds/updates tags it's told about, and never removes a tag some other
# process or person set (e.g. aws: reserved-prefix tags, or a
# Terraform-managed tag not listed here).
PRUNE_UNMANAGED_TAGS=false
