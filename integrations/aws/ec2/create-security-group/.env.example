# ============================================================================
# PARAMS for aws/ec2/create-security-group — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in the
# repo-root .env; setting one of those keys here is a hard error.
#
# This integration declares credentials: ["aws"] only.
# ============================================================================

# --- Security group identity ---
# Names are unique per-VPC (AWS's own constraint) — a same-named group in
# this VPC not owned by this integration aborts the run as a conflict.
GROUP_NAME=
GROUP_DESCRIPTION=
VPC_ID=

# --- Starting rule sets ---
# Each is a JSON array of rules: { protocol, fromPort?, toPort?, cidr?,
# sourceGroupId? }. Exactly one of cidr/sourceGroupId per rule. Applied once
# at creation; re-applied (missing rules only) if a prior partial run left
# the group existing but under-ruled. Ongoing changes after that belong to
# aws/ec2/update-security-group-rules, not this integration.
#
# Example:
# INGRESS_RULES=[{"protocol":"tcp","fromPort":22,"toPort":22,"cidr":"10.0.0.0/16"}]
INGRESS_RULES=[]
EGRESS_RULES=[]
