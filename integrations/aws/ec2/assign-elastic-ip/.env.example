# ============================================================================
# PARAMS for aws/ec2/assign-elastic-ip — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in
# the repo-root .env; setting one of those keys here is a hard error.
#
# This integration declares credentials: ["aws"] only.
#
# This only covers "allocate a new Elastic IP and associate it" — it does not
# cover "associate an existing pre-allocated EIP", a different, simpler task
# not built here.
# ============================================================================

# --- Identity ---
# Used as the `ferry:logical-name` tag — this, plus a `ferry:integration-id`
# tag, is what check() matches an existing Elastic IP against. Two different
# LOGICAL_NAME values allocate two different EIPs; the same value re-run finds
# the one already allocated instead of allocating a second one.
LOGICAL_NAME=

# The instance to associate the Elastic IP with. Must already exist.
INSTANCE_ID=

# Optional — JSON object of extra tags applied alongside the ferry identity
# tag pair. Leave blank for none.
TAGS=
