# ============================================================================
# PARAMS for aws/ec2/create-ami-from-instance — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in
# the repo-root .env; setting one of those keys here is a hard error.
#
# This integration declares credentials: ["aws"] only.
# ============================================================================

INSTANCE_ID=

# Identity tag used for idempotent re-runs (ferry:logical-name, alongside
# ferry:integration-id) — NOT the AMI's Name field. This is what lets a
# re-run recognize "this run already baked this AMI" via DescribeImages,
# since AMIs have no natural existence check by name/content alone.
LOGICAL_NAME=

AMI_NAME=
DESCRIPTION=

# "true" or "false", default "false" — matches CreateImage's own API default.
#
# IMPORTANT: with the default (false), creating this AMI REBOOTS the source
# instance. Per AWS's docs, the reboot happens "to ensure that all buffered
# data and data in memory is written to the volumes before the snapshots are
# created" (full consistency). Setting NO_REBOOT=true skips the reboot, but
# the resulting snapshots then only capture "data that has been written to
# the volumes at the time the snapshots are created" (crash-consistent, not
# fully consistent) — AWS's own wording for the risk. This is a real,
# deliberate tradeoff you are making explicitly, not a default this
# integration hides from you.
NO_REBOOT=false

# Optional. Flat JSON object of string->string, applied to the AMI tag
# specification alongside the ferry identity tags. Leave empty for none.
TAGS_JSON=
