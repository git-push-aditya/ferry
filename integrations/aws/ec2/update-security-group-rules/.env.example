# ============================================================================
# PARAMS for aws/ec2/update-security-group-rules — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in the
# repo-root .env; setting one of those keys here is a hard error.
#
# This integration declares credentials: ["aws"] only.
# ============================================================================

# --- Security group ---
# Must already exist — this integration never creates one. Use
# aws/ec2/create-security-group (or any existing group id) to get one first.
GROUP_ID=

# --- Desired rule sets ---
# Each is a JSON array of rules: { protocol, fromPort?, toPort?, cidr?,
# sourceGroupId? }. Exactly one of cidr/sourceGroupId per rule. This is the
# FULL desired set, not a delta — every run diffs the live rule set against
# this and applies only what's missing or extra, converging to exactly this
# set regardless of the group's current state.
#
# Example:
# DESIRED_INGRESS_RULES=[{"protocol":"tcp","fromPort":22,"toPort":22,"cidr":"10.0.0.0/16"}]
DESIRED_INGRESS_RULES=[]
DESIRED_EGRESS_RULES=[]
