# ============================================================================
# PARAMS for aws/ec2/launch-instance — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in
# the repo-root .env; setting one of those keys here is a hard error.
#
# This integration declares credentials: ["aws"] only.
# ============================================================================

# --- Identity ---
# Used as the `ferry:logical-name` tag — this, plus a `ferry:integration-id`
# tag, is what check() matches an existing instance against. Two different
# LOGICAL_NAME values launch two different instances; the same value re-run
# finds the one already launched instead of launching a second one.
LOGICAL_NAME=

# --- Launch settings ---
AMI_ID=
INSTANCE_TYPE=
SUBNET_ID=
# Comma-separated, no spaces required (they're trimmed): sg-aaa,sg-bbb
SECURITY_GROUP_IDS=

# Optional — omit for a keyless launch (e.g. SSM-managed instances).
KEY_PAIR_NAME=

# Optional — supply to force reuse of a specific ClientToken (e.g. retrying a
# run that RunInstances succeeded for but the poll to "running" didn't
# confirm). Leave blank to generate a fresh one each run.
CLIENT_TOKEN_OVERRIDE=

# Optional — JSON object of extra tags applied alongside the ferry identity
# tag pair. Leave blank for none.
TAGS=
