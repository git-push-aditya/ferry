# ============================================================================
# PARAMS for aws/ec2/create-ebs-snapshot — NO CREDENTIALS.
#
# This integration operates on a volume that already exists — it does not
# create one.
# ============================================================================

VOLUME_ID=
# Identity tag used to find "did I already snapshot this volume for this
# reason" on a retried run, so a re-run does not create a second, redundant
# snapshot. Pick something stable and meaningful, e.g. "nightly-backup".
LOGICAL_NAME=

DESCRIPTION=

# Flat JSON object of string keys to string values, e.g. {"env":"prod"}.
# Applied in addition to the ferry identity tags. Leave empty for none.
TAGS=

# EBS can snapshot an attached, in-use volume directly — this is NOT
# required for a consistent snapshot. Set to true only as a convenience for
# a fully consistent ROOT-volume snapshot, in which case INSTANCE_ID is also
# required. Defaults to false.
STOP_INSTANCE_FIRST=false
# Required only when STOP_INSTANCE_FIRST=true. The instance is restarted
# after the snapshot completes (or fails) either way.
INSTANCE_ID=
