# ============================================================================
# PARAMS for aws/ec2/resize-ebs-volume — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in
# the repo-root .env; setting one of those keys here is a hard error.
#
# This integration declares credentials: ["aws"] only.
# ============================================================================

VOLUME_ID=
# Whole GiB only. Must be >= the volume's current size — EBS volumes can
# only grow via ModifyVolume; there is no shrink operation.
TARGET_SIZE_GIB=

# --- Optional — only passed to ModifyVolume if set ---
VOLUME_TYPE=
IOPS=
THROUGHPUT=

# --- Optional in-OS filesystem grow, via SSM Run Command — BOTH or NEITHER ---
#
# IMPORTANT: growing the AWS-side EBS volume does NOT grow the partition or
# filesystem inside the guest OS. Per ModifyVolume's own docs: "When you
# complete a resize operation on your volume, you need to extend the volume's
# file-system size to take advantage of the new storage capacity." That is a
# separate, subsequent, guest-OS-level action (growpart/resize2fs/xfs_growfs
# on Linux, Disk Management on Windows) — a fundamentally different trust
# boundary than the AWS API credentials this integration otherwise uses.
#
# Leave both empty (the default) to have this run stop at the AWS-side
# resize only — the report and verify() will say plainly that filesystem
# growth was not performed. Set both to opt into running an SSM document
# against the instance that grows the filesystem for you.
SSM_DOCUMENT_NAME=
SSM_INSTANCE_ID=
