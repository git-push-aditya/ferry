# ============================================================================
# PARAMS for aws/ec2/attach-detach-ebs-volume — NO CREDENTIALS.
#
# This integration operates on a volume and instance that already exist — it
# does not create either. Run aws/ec2/launch-instance first for the instance;
# volume creation is out of scope for this plan.
# ============================================================================

VOLUME_ID=
INSTANCE_ID=
# e.g. /dev/sdf
DEVICE=
# attach or detach.
ACTION=attach

# Maps directly to DetachVolume's own Force param. AWS's own docs call this a
# "last resort" that "can lead to data loss or a corrupted file system" —
# only set to true if a normal detach is stuck. Defaults to false. Ignored
# when ACTION=attach.
FORCE=false
