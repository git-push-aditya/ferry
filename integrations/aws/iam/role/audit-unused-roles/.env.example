# ============================================================================
# PARAMS for aws/iam/role/audit-unused-roles — NO CREDENTIALS.
#
# This integration is read-only. It makes no AWS mutations and has nothing
# to roll back.
# ============================================================================

# Age (in days) past which a used-but-old role is flagged as a stale
# candidate. Treat this as your own policy choice, not an AWS-recommended
# default.
STALE_THRESHOLD_DAYS=90

# AWS-managed / service-linked roles are excluded by default — set to true to
# include them in the audit.
INCLUDE_SERVICE_LINKED_ROLES=false

# Opt-in deeper Access Advisor pass, run only against candidate roles flagged
# by the cheap RoleLastUsed signal. Costs one async job per candidate.
RUN_DEEP_ACCESS_ADVISOR_PASS=false

# Optional. Scopes the audit to roles under a given path prefix, e.g.
# /my-team/.
PATH_PREFIX_FILTER=
