# ============================================================================
# PARAMS for aws/iam/role/create-role — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in the
# repo-root .env; setting one of those keys here is a hard error.
#
# This integration declares credentials: ["aws"] only.
# ============================================================================

# --- Role identity ---
ROLE_NAME=

# The full AssumeRolePolicyDocument, as JSON text on one line (or a quoted
# multi-line value — this file's parser unescapes \n inside double quotes).
# Example: '{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Principal":{"Service":"ec2.amazonaws.com"},"Action":"sts:AssumeRole"}]}'
TRUST_POLICY=

# --- Optional ---
PATH=
DESCRIPTION=
# Must be between 3600 and 43200 if set.
MAX_SESSION_DURATION_SECONDS=
PERMISSIONS_BOUNDARY_ARN=
