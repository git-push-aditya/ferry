# ============================================================================
# PARAMS for aws/iam/role/tag-role — NO CREDENTIALS.
#
# This integration operates on a role that already exists — it does not
# create one. Run aws/iam/role/create-role first if you need it provisioned.
# ============================================================================

ROLE_NAME=
# A flat JSON object of string tags, e.g. {"env":"prod","owner":"data-team"}.
# Leave empty to leave whatever tags the role already has untouched. TagRole
# merges — keys you don't mention here are never touched, and there is no
# "clear everything" sentinel; use UntagRole directly if you need that.
TAGS_JSON=
