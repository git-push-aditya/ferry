# ============================================================================
# PARAMS for aws/iam/role/delete-role — NO CREDENTIALS.
# ============================================================================

ROLE_NAME=

# If true, also deletes any instance profile the role was removed from — but
# only if that profile has no other roles attached. Shared profiles are
# skipped with a warning, never deleted out from under other roles.
DELETE_INSTANCE_PROFILES_TOO=false
