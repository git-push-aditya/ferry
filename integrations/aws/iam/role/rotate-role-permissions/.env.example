# ============================================================================
# PARAMS for aws/iam/role/rotate-role-permissions — NO CREDENTIALS.
#
# The role must already exist — this integration operates on it, it does not
# create one. Run aws/iam/role/create-role first if you need it provisioned.
# ============================================================================

ROLE_NAME=

# The COMPLETE target set of managed-policy ARNs, comma-separated. This is not
# a delta from the current set — whatever isn't listed here gets detached.
# Example:
# DESIRED_POLICY_ARNS=arn:aws:iam::123456789012:policy/ReadOnlyExport,arn:aws:iam::aws:policy/AmazonS3ReadOnlyAccess
DESIRED_POLICY_ARNS=
