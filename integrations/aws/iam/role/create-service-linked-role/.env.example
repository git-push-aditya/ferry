# ============================================================================
# PARAMS for aws/iam/role/create-service-linked-role — NO CREDENTIALS.
# ============================================================================

# The service principal string, case-sensitive, exactly as it appears in
# AWS's own service-linked-role documentation for the service you're using.
# Example: elasticbeanstalk.amazonaws.com
AWS_SERVICE_NAME=

# REQUIRED. The exact resolved role name AWS will use for this service, e.g.
# AWSServiceRoleForElasticBeanstalk (optionally with CUSTOM_SUFFIX appended).
# Look this up ahead of time from AWS's own docs for AWS_SERVICE_NAME — see
# README.md for why Ferry requires this rather than guessing it.
EXPECTED_ROLE_NAME=

# Optional. Only some services support this, to allow more than one
# service-linked role per account for the same service.
CUSTOM_SUFFIX=

# Optional.
DESCRIPTION=
