# ============================================================================
# PARAMS for aws/iam/role/attach-policy-to-role — NO CREDENTIALS.
#
# This integration operates on a role that already exists — it does not
# create one. Run aws/iam/role/create-role first if you need it provisioned.
# ============================================================================

ROLE_NAME=
# Full ARN — AWS-managed (arn:aws:iam::aws:policy/...) or customer-managed
# (arn:aws:iam::<account-id>:policy/...). Resolve a bare policy name to an ARN
# yourself first if that's all you have.
POLICY_ARN=
