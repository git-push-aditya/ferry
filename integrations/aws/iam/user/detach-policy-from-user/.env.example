# ============================================================================
# PARAMS for aws/iam/user/detach-policy-from-user — NO CREDENTIALS.
#
# Safe to run even if the user or policy is already gone — idempotent no-op.
# ============================================================================

IAM_USER_NAME=
# Full ARN — AWS-managed (arn:aws:iam::aws:policy/...) or customer-managed
# (arn:aws:iam::<account-id>:policy/...).
IAM_POLICY_ARN=
