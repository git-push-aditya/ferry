# ============================================================================
# PARAMS for aws/iam/user/delete-user — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in the
# repo-root .env; setting one of those keys here is a hard error.
# ============================================================================

IAM_USER_NAME=

# REQUIRED CONFIRMATION, not a convenience flag. This permanently destroys
# access keys, the login profile password, MFA devices, and every group/
# policy attachment the user holds — with NO recovery path. AWS never returns
# a deleted access key's secret or a deleted login profile's password again.
# Must be set to exactly "true" to proceed; anything else (including unset)
# aborts in the plan phase before any change is made.
ALLOW_DESTRUCTIVE_TEARDOWN=false
