# ============================================================================
# PARAMS for aws/iam/user/deactivate-access-key — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in
# the repo-root .env; setting one of those keys here is a hard error.
#
# This integration declares credentials: ["aws"] only.
# ============================================================================

IAM_USER_NAME=
# Which of the user's (up to two) access keys to deactivate. Required —
# ambiguity here is unsafe, so this is never inferred.
ACCESS_KEY_ID=
