# ============================================================================
# PARAMS for aws/iam/user/create-access-key — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in the
# repo-root .env; setting one of those keys here is a hard error.
#
# This integration declares credentials: ["aws"] only. It operates on an
# EXISTING user — run aws/iam/user/create-user first if it does not exist yet.
# ============================================================================

# Plain AWS IAM user name. Must already exist.
IAM_USER_NAME=

# AWS hard-caps access keys at 2 per user — not configurable, not raisable.
#
# false (default): a user already holding 1 key is left alone. Re-running this
#   integration mints nothing and burns no quota.
# true: mints a second key even if one already exists — the intended use is a
#   short rotation window (mint the new key, cut services over, delete the
#   old one). A user already at 2 keys is always left alone regardless of
#   this flag; a third CreateAccessKey call would 409.
ALLOW_SECOND_KEY=false
