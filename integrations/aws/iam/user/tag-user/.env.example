# ============================================================================
# PARAMS for aws/iam/user/tag-user — NO CREDENTIALS.
#
# This integration operates on a user that already exists — it does not
# create one. Run aws/iam/user/create-user first if you need it provisioned.
# ============================================================================

IAM_USER_NAME=
# A flat JSON object of string tags, e.g. {"env":"prod","owner":"data-team"}.
# Leave empty to leave whatever tags the user already has untouched. TagUser
# merges — keys you don't mention here are never touched by default.
TAGS_JSON=
# Set to "true" to also remove tags present on the user but absent from
# TAGS_JSON above (full declarative convergence). Default "false": additive/
# update-only, never silently deletes a tag some other process set.
PRUNE_UNMANAGED_TAGS=false
