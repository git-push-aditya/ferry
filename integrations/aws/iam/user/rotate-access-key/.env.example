# ============================================================================
# PARAMS for aws/iam/user/rotate-access-key — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in
# the repo-root .env; setting one of those keys here is a hard error.
#
# This integration declares credentials: ["aws"] only.
#
# THIS IS A TWO-PHASE, HUMAN-GATED PROCESS. See README.md before running.
# ============================================================================

IAM_USER_NAME=

# --- Phase B gate ---
# Leave false for the first run: it only mints a second key (Phase A) and
# leaves the old one completely untouched. Do NOT set this true until you
# have migrated every configured credential to the new key and confirmed
# your application works with it. Once true, re-running this integration
# deactivates AND DELETES the old key — deletion is irreversible.
CONFIRM_CUTOVER=false

# Optional soak window (minutes) between deactivating and deleting the old
# key, once CONFIRM_CUTOVER=true. 0 = deactivate and delete back-to-back in
# the same run, with no wait.
ROTATION_SOAK_MINUTES=0
