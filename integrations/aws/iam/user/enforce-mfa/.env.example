# ============================================================================
# PARAMS for aws/iam/user/enforce-mfa — NO CREDENTIALS.
#
# This integration operates on a user that already exists — it does not
# create one. Run aws/iam/user/create-user first if you need it provisioned.
#
# READ THE README before relying on this: there is no "require MFA" attribute
# on an IAM user. Enforcement is a policy Condition, and it only constrains
# callers using STS temporary credentials (GetSessionToken/AssumeRole) — a
# long-term IAM access key never carries MFA session context and is entirely
# unaffected by the condition this integration adds.
# ============================================================================

IAM_USER_NAME=
# Must be a CUSTOMER-MANAGED policy ARN — AWS-managed policies
# (arn:aws:iam::aws:policy/...) cannot have new versions created on them.
IAM_POLICY_ARN=
# Optional. If set, also requires the session to be no older than this many
# seconds (aws:MultiFactorAuthAge), in addition to aws:MultiFactorAuthPresent.
# Leave empty for a bare MFA-present check with no age limit.
MFA_CONDITION_MAX_AGE_SECONDS=
# Whether to also provision (not enable) a virtual MFA device for the user.
# Default true. CreateVirtualMFADevice only gets you to "awaiting human
# enablement" — EnableMFADevice needs two live authenticator codes that only
# a human can produce. Set to "false" if enablement is already handled
# out-of-band and you only want the policy half.
PROVISION_VIRTUAL_DEVICE=true
