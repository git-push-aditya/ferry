# ============================================================================
# PARAMS for aws/iam/user/attach-policy-to-user — NO CREDENTIALS.
#
# This integration operates on a user that already exists — it does not
# create one. Run aws/iam/user/create-user first if you need it provisioned.
# ============================================================================

IAM_USER_NAME=
# Full ARN — AWS-managed (arn:aws:iam::aws:policy/...) or customer-managed
# (arn:aws:iam::<account-id>:policy/...). Resolve a bare policy name to an ARN
# yourself first if that's all you have.
IAM_POLICY_ARN=
