# ============================================================================
# PARAMS for aws/iam/user/add-user-to-group — NO CREDENTIALS.
#
# This integration operates on a user and group that already exist — it does
# not create either. Run aws/iam/user/create-user first if you need the user
# provisioned. Group lifecycle is out of scope for this integration.
# ============================================================================

IAM_USER_NAME=
IAM_GROUP_NAME=
