# ============================================================================
# PARAMS for aws/iam/user/create-user — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in the
# repo-root .env; setting one of those keys here is a hard error.
#
# This integration declares credentials: ["aws"] only.
# ============================================================================

# Plain AWS IAM user name.
IAM_USER_NAME=

# Optional. Defaults to "/" (AWS's own default) when left blank.
IAM_USER_PATH=

# Optional. ARN of a permissions boundary policy — the single cheapest
# guardrail against over-broad follow-on policy attachments. Leave blank for
# no boundary.
IAM_PERMISSIONS_BOUNDARY_ARN=
