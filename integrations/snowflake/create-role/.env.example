# ============================================================================
# PARAMS for snowflake/create-role — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in the
# repo-root .env; setting one of those keys here is a hard error.
# ============================================================================

# --- Snowflake object name ---
# Snowflake unquoted identifier: letters/digits/underscore only, can't start
# with a digit or contain '-' (the SQL parser reads a hyphen as subtraction).
ROLE_NAME=

# --- Optional initial privilege set ---
# JSON array of {privilege, onType, onName}, granted once at role-creation
# time. Leave blank for a bare role with no starting privileges (e.g. one
# meant to be composed later purely via GRANT ROLE ... TO ROLE).
# Example:
# INITIAL_GRANTS=[{"privilege":"USAGE","onType":"WAREHOUSE","onName":"COMPUTE_WH"}]
INITIAL_GRANTS=
