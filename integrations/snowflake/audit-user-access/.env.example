# ============================================================================
# PARAMS for snowflake/audit-user-access — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in
# the repo-root .env; setting one of those keys here is a hard error.
#
# This integration is READ-ONLY and audits whichever Snowflake account the
# root `.env` currently points at — there is no staging/prod scope
# parameter. To audit both accounts, run this twice, once with each
# account's root .env active. See README.md.
# ============================================================================

# Snowflake unquoted identifier: letters/digits/underscore only, no leading
# digit, no hyphen.
USER_NAME=
