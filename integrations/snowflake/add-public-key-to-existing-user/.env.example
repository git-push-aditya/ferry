# ============================================================================
# PARAMS for snowflake/add-public-key-to-existing-user — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in the
# repo-root .env; setting one of those keys here is a hard error.
# ============================================================================

# --- Target user ---
# Snowflake unquoted identifier: letters/digits/underscore only, can't start
# with a digit or contain '-' (the SQL parser reads a hyphen as subtraction).
# The user must already exist — this task never creates one.
USER_NAME=

# --- Key material ---
# Full PEM block (-----BEGIN PUBLIC KEY----- ... -----END PUBLIC KEY-----) or
# bare base64 — either is accepted, PEM armor and whitespace are stripped
# before it's sent to Snowflake.
PUBLIC_KEY=

# --- Slot selection (optional) ---
# "1" or "2" to explicitly pick a key slot. Leave unset to auto-detect the
# first empty slot (RSA_PUBLIC_KEY, then RSA_PUBLIC_KEY_2). Required if both
# slots are already occupied and you intend to overwrite one — otherwise the
# run reports a conflict and points you at rotate-user-key-pair instead.
TARGET_SLOT=
