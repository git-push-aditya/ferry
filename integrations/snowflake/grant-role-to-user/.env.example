# ============================================================================
# PARAMS for snowflake/grant-role-to-user — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in the
# repo-root .env; setting one of those keys here is a hard error.
#
# Both USER_NAME and ROLE_NAME must already exist — this integration does not
# create either. See README.
# ============================================================================

# --- Snowflake object names ---
# Snowflake unquoted identifiers: letters/digits/underscore only, can't start
# with a digit or contain '-' (the SQL parser reads a hyphen as subtraction).
USER_NAME=
ROLE_NAME=
