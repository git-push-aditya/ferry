# ============================================================================
# PARAMS for snowflake/rotate-user-key-pair — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in the
# repo-root .env; setting one of those keys here is a hard error.
# ============================================================================

# --- Target user ---
# Snowflake unquoted identifier: letters/digits/underscore only, can't start
# with a digit or contain '-' (the SQL parser reads a hyphen as subtraction).
USER_NAME=

# --- New key material ---
# Full PEM block (-----BEGIN PUBLIC KEY----- ... -----END PUBLIC KEY-----) or
# bare base64 — either is accepted, PEM armor and whitespace are stripped
# before it's sent to Snowflake.
NEW_PUBLIC_KEY=

# --- Cutover gate ---
# "true" or "false". Leave "false" (default) for the first run: this mints the
# new key into the unused slot and leaves the old key untouched. Once you've
# updated every configured Snowflake connection to use the new key and
# confirmed they authenticate, re-run with this set to "true" to retire the
# old key. THIS IS IRREVERSIBLE — the old key's raw material is never
# captured by Ferry and cannot be restored once cleared.
CONFIRM_CUTOVER=false
