# ============================================================================
# PARAMS for snowflake/snowpipe-auto-ingest — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in the
# repo-root .env; setting one of those keys here is a hard error.
#
# This integration declares credentials: ["aws", "snowflake"]. The stage
# must already exist — run snowflake/create-storage-s3-integration first.
# ============================================================================

SF_PIPE_NAME=
SF_TARGET_TABLE=
SF_STAGE_NAME=
SF_FILE_FORMAT=TYPE = CSV

# Must be the same bucket SF_STAGE_NAME's URL points at.
S3_BUCKET_NAME=
S3_INGEST_PREFIX=
