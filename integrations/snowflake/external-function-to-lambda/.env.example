# ============================================================================
# PARAMS for snowflake/external-function-to-lambda — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in the
# repo-root .env; setting one of those keys here is a hard error.
#
# This integration declares credentials: ["aws", "snowflake"]. The Lambda +
# API Gateway resource must already be deployed with a real, live invoke
# URL before this runs — this integration never provisions it.
# ============================================================================

SF_API_INTEGRATION_NAME=
AWS_API_ROLE_NAME=

API_GATEWAY_INVOKE_URL=

SF_EXTERNAL_FUNCTION_NAME=
# Comma-separated Snowflake SQL types, e.g. "VARCHAR, NUMBER"
SF_FUNCTION_ARG_TYPES=VARCHAR
SF_FUNCTION_RETURNS=VARCHAR

# Comma-separated literal SQL values for verify()'s smoke-test call, in the
# same order as SF_FUNCTION_ARG_TYPES, e.g. "'hello'"
SMOKE_TEST_ARGS='hello'
