# ============================================================================
# PARAMS for snowflake/s3-storage-integration — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in the
# repo-root .env; setting one of those keys here is a hard error.
#
# Nothing here is inherited from the root .env or from any other integration —
# EXPORT_S3_BUCKET is declared again in integrations/aws/s3-backend-access on
# purpose, so each folder stands alone.
# ============================================================================

# --- S3 target ---
# Bare bucket name: no s3:// prefix, no trailing slash. Bucket names are
# globally unique across all AWS accounts.
EXPORT_S3_BUCKET=
# Key prefix Snowflake writes under. MUST end with '/'.
EXPORT_S3_PREFIX=

# --- Snowflake object names ---
# Snowflake unquoted identifiers: letters/digits/underscore only, can't start
# with a digit or contain '-' (the SQL parser reads a hyphen as subtraction).
SF_STORAGE_INTEGRATION_NAME=
SF_STAGE_NAME=

# --- AWS IAM object names ---
# Plain AWS resource names; hyphens are fine here.
AWS_STORAGE_ROLE_NAME=
AWS_STORAGE_POLICY_NAME=

# --- Access scoping ---
# read-write (default, unchanged behavior): IAM policy grants
#   GetObject/PutObject/DeleteObject on the prefix.
# read-only: IAM policy grants only GetObject/ListBucket on the prefix —
#   writes through the stage will be denied by AWS.
ACCESS_MODE=read-write
