# ============================================================================
# PARAMS for snowflake/set-user-roles — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in the
# repo-root .env; setting one of those keys here is a hard error.
#
# This integration declares credentials: ["snowflake"] only.
# ============================================================================

USER_NAME=

# JSON array of role identifiers the user should hold when this run finishes.
ROLES=["ANALYST"]

# Revoke roles the user holds that are NOT listed in ROLES. Default false, so
# the common case is purely additive and cannot silently remove access.
# Set true for a role change or an offboard.
PRUNE_UNMANAGED_ROLES=false

# Optional. Must also appear in ROLES.
DEFAULT_ROLE=
