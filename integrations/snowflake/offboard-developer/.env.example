# ============================================================================
# PARAMS for snowflake/offboard-developer — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in
# the repo-root .env; setting one of those keys here is a hard error.
#
# This integration runs against whichever Snowflake account the root `.env`
# currently points at — there is no staging/prod scope parameter. To
# offboard a developer from both accounts, run this twice, once with each
# account's root .env active. See README.md.
# ============================================================================

# Snowflake unquoted identifier: letters/digits/underscore only, no leading
# digit, no hyphen.
USER_NAME=

# Default false: DISABLE (ALTER USER ... SET DISABLED = TRUE), reversible.
# Set to true ONLY for an explicit, intentional hard delete (DROP USER) —
# irreversible, no UNDROP. Read the README before ever setting this true.
HARD_DELETE=false

# Optional free-text audit-trail metadata (e.g. "resigned 2026-08-10").
# Never used in any SQL statement — purely for the generated report.
OFFBOARD_REASON=
