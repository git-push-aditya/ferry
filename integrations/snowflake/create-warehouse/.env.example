# ============================================================================
# PARAMS for snowflake/create-warehouse — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in the
# repo-root .env; setting one of those keys here is a hard error.
# ============================================================================

# Snowflake unquoted identifier: letters/digits/underscore only, can't start
# with a digit or contain '-' (the SQL parser reads a hyphen as subtraction).
WAREHOUSE_NAME=

# One of Snowflake's standard T-shirt sizes: XSMALL, SMALL, MEDIUM, LARGE,
# XLARGE, XXLARGE, XXXLARGE, X4LARGE, X5LARGE, X6LARGE. Defaults to XSMALL.
WAREHOUSE_SIZE=XSMALL

# Seconds of inactivity before Snowflake auto-suspends the warehouse. Defaults
# to 60.
AUTO_SUSPEND_SECONDS=60

# "true"/"false". Whether the warehouse auto-resumes on the next query.
# Defaults to true.
AUTO_RESUME=true
