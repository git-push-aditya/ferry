# ============================================================================
# PARAMS for snowflake/grant-database-schema-access — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in the
# repo-root .env; setting one of those keys here is a hard error.
#
# ROLE_NAME and the OBJECT_NAME target must already exist — this integration
# does not create either. See README.
# ============================================================================

# --- Snowflake object names ---
# Snowflake unquoted identifiers: letters/digits/underscore only, can't start
# with a digit or contain '-' (the SQL parser reads a hyphen as subtraction).
ROLE_NAME=

# DATABASE or SCHEMA.
OBJECT_TYPE=DATABASE

# For OBJECT_TYPE=DATABASE, just the database name. For OBJECT_TYPE=SCHEMA,
# qualify as `database.schema` unless it's in the current session database.
# Not restricted to ROLE_NAME's single-identifier rule since a qualified name
# legitimately contains a '.'.
OBJECT_NAME=

# --- Desired privilege set ---
# Comma-separated Snowflake privileges, e.g. "USAGE,SELECT".
DESIRED_PRIVILEGES=USAGE

# --- Pruning ---
# false (default) — additive only: privileges this role already holds but
# aren't listed above are left untouched.
# true — converge to an EXACT set: anything not listed above is revoked.
PRUNE_UNMANAGED_PRIVILEGES=false
