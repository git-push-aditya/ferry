# ============================================================================
# PARAMS for snowflake/onboard-developer-prod — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in
# the repo-root .env; setting one of those keys here is a hard error.
#
# IMPORTANT: this integration does not select which Snowflake account it
# talks to. "Staging" vs "prod" is decided entirely by the root .env's
# SNOWFLAKE_ACCOUNT (and matching admin credentials) that's active when you
# run this command. Point the root .env at your PROD account before running
# this folder, and make sure you have already been through your org's real
# prod-access approval process out of band — see README.md.
# ============================================================================

# Snowflake unquoted identifier: letters/digits/underscore only, can't start
# with a digit or contain '-'.
USER_NAME=

# Developer's email, stored on the CREATE USER statement.
EMAIL=

# RSA public key for key-pair auth. Either a full PEM block (with
# -----BEGIN PUBLIC KEY----- / -----END PUBLIC KEY----- lines) or the bare
# base64 body — both are accepted, PEM wrapper lines are stripped
# automatically if present.
PUBLIC_KEY=

# Role granted to the user as DEFAULT_ROLE. Must already exist in this
# account — this integration does not create roles (see create-role).
DEFAULT_ROLE=
