# ============================================================================
# PARAMS for snowflake/secrets-manager-snowflake-keypair-sync — NO CREDENTIALS.
#
# Copy to `.env` in this folder and fill in every value. Credentials live in the
# repo-root .env; setting one of those keys here is a hard error.
#
# This integration declares credentials: ["aws", "snowflake"]. It GENERATES
# a private key and briefly holds it in memory — read the README's
# security note before using this in production.
# ============================================================================

# Must already exist — this integration never creates a Snowflake user.
SF_USER_NAME=

# Created if missing, updated (a new secret version) if it already exists.
AWS_SECRET_NAME=

# Forces a fresh key pair even if the synced-fingerprint tag already
# matches. Defaults false.
FORCE_ROTATE=false
