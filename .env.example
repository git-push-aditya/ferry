# ============================================================================
# ROOT .env — CREDENTIALS ONLY.
#
# Everything in this file is a credential shared by every integration. Resource
# names, bucket names, target names and toggles do NOT belong here: each
# integration declares its own params in its own folder .env. See
# integrations/*/*/.env.example.
#
# An integration folder .env that sets any key from this file is a hard error —
# a checked-out folder must never be able to redirect a run at another account.
#
# You only need the credential blocks the integration you're running declares.
# `aws/s3-backend-access` declares ["aws"], so it never asks for Snowflake.
# ============================================================================

# --- AWS admin bootstrap creds (credential kind: "aws") ---
# The identity used to RUN ferry: needs IAM write access (create/attach
# policies, create/update roles + trust policies, create users, create buckets).
# This is NOT the credential your application uses — see
# integrations/aws/s3-backend-access, which mints that one.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=

# --- Snowflake creds (credential kind: "snowflake") ---
# SNOWFLAKE_ROLE must be able to CREATE INTEGRATION (in practice ACCOUNTADMIN).
# Provide SNOWFLAKE_PASSWORD or SNOWFLAKE_PRIVATE_KEY (at least one required).
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE is only needed if the key is encrypted.
# SNOWFLAKE_PRIVATE_KEY accepts either the raw PEM (PKCS8, "-----BEGIN PRIVATE
# KEY-----") or that same PEM base64-encoded on one line — both are detected
# automatically.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USERNAME=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_PRIVATE_KEY=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
