# ============================================================================
# INPUT — every variable in this file must be filled in by you BEFORE running
# either script. Both scripts validate this file with zod on startup and
# refuse to make any API call if anything required is missing or blank.
#
# There is no OUTPUT section in this file. The one value these scripts
# produce — the backend service's generated AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY pair — is never written here. `setup:backend` writes
# it to a markdown report under ./output/ (chmod 0600, gitignored) and echoes
# only the non-secret AWS_ACCESS_KEY_ID to stdout; with --write-env it also
# writes the pair to ./.env.backend (chmod 0600, gitignored). Neither file
# exists until you run the script; this file is the only one you edit by hand.
# ============================================================================

# --- INPUT: AWS admin bootstrap creds (required before start — BOTH scripts) ---
# The identity used to RUN the scripts: needs IAM write access (create/attach
# policies, create/update roles + trust policies, create users, create buckets).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=

# --- INPUT: S3 target (required before start — BOTH scripts) ---
EXPORT_S3_BUCKET=
EXPORT_S3_PREFIX=

# --- INPUT: Snowflake creds (required before start — setup:integration only) ---
# SNOWFLAKE_ROLE must be able to CREATE INTEGRATION (in practice ACCOUNTADMIN).
# Provide SNOWFLAKE_PASSWORD or SNOWFLAKE_PRIVATE_KEY (at least one required).
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE is only needed if the key is encrypted.
# SNOWFLAKE_PRIVATE_KEY accepts either the raw PEM (PKCS8, "-----BEGIN PRIVATE
# KEY-----") or that same PEM base64-encoded on one line — both are detected
# automatically.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USERNAME=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_PRIVATE_KEY=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# --- INPUT: resource names (required before start — setup:integration only) ---
# SF_STORAGE_INTEGRATION_NAME and SF_STAGE_NAME are Snowflake unquoted
# identifiers: letters/digits/underscore only, can't start with a digit or
# contain '-' (Snowflake's SQL parser reads a hyphen as subtraction, not a
# name). AWS_STORAGE_ROLE_NAME/AWS_STORAGE_POLICY_NAME are plain AWS resource
# names and may use hyphens.
SF_STORAGE_INTEGRATION_NAME=
SF_STAGE_NAME=
AWS_STORAGE_ROLE_NAME=
AWS_STORAGE_POLICY_NAME=

# --- INPUT: resource names (required before start — setup:backend only) ---
BACKEND_IAM_USER_NAME=
BACKEND_IAM_POLICY_NAME=

# ============================================================================
# OUTPUT (produced elsewhere, not here):
#   ./output/*.md   <- written by BOTH scripts on success. setup:backend's
#                      report contains the generated AWS_ACCESS_KEY_ID /
#                      AWS_SECRET_ACCESS_KEY; setup:integration's contains the
#                      role's trust-policy external id. Both are sensitive.
#   ./.env.backend  <- written by `bun run setup:backend -- --write-env`
#                      contains: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
#                      for the generated least-privilege backend user.
#                      This is the runtime credential your app consumes —
#                      never the admin bootstrap creds above.
# ============================================================================
