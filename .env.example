# ============================================================================
# INPUT — every variable in this file must be filled in by you BEFORE running
# either script. Both scripts validate this file with zod on startup and
# refuse to make any API call if anything required is missing or blank.
#
# There is no OUTPUT section in this file. The one value these scripts
# produce — the backend service's generated AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY pair — is never written here. `setup:backend` prints
# it once to stdout and, only with --write-env, appends it to a SEPARATE
# file: ./.env.backend (chmod 0600, gitignored). That file does not exist
# until you run the script; this file is the only one you edit by hand.
# ============================================================================

# --- INPUT: AWS admin bootstrap creds (required before start — BOTH scripts) ---
# The identity used to RUN the scripts: needs IAM write access (create/attach
# policies, create/update roles + trust policies, create users, create buckets).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=

# --- INPUT: S3 target (required before start — BOTH scripts) ---
EXPORT_S3_BUCKET=
EXPORT_S3_PREFIX=

# --- INPUT: Snowflake creds (required before start — setup:integration only) ---
# SNOWFLAKE_ROLE must be able to CREATE INTEGRATION (in practice ACCOUNTADMIN).
# Provide SNOWFLAKE_PASSWORD or SNOWFLAKE_PRIVATE_KEY (at least one required).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USERNAME=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_PRIVATE_KEY=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# --- INPUT: resource names (required before start — setup:integration only) ---
SF_STORAGE_INTEGRATION_NAME=
SF_STAGE_NAME=
AWS_STORAGE_ROLE_NAME=
AWS_STORAGE_POLICY_NAME=

# --- INPUT: resource names (required before start — setup:backend only) ---
BACKEND_IAM_USER_NAME=
BACKEND_IAM_POLICY_NAME=

# ============================================================================
# OUTPUT (produced elsewhere, not here):
#   ./.env.backend  <- written by `bun run setup:backend -- --write-env`
#                      contains: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
#                      for the generated least-privilege backend user.
#                      This is the runtime credential your app consumes —
#                      never the admin bootstrap creds above.
# ============================================================================
